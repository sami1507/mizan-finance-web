# Copy to .env in the project root so Next.js and CLI commands use the same values.
# Next.js also reads .env.local; CLI commands do not. Deployed values belong in the host's server environment.
# This file contains placeholders only. See docs/API_SETUP.md before production deployment.
# PostgreSQL 16+; use a direct or session-pooled URL, with verified TLS according to the provider.
# Example only: postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
DATABASE_URL=
# Public canonical origin (no trailing path). Production must use your own HTTPS origin.
BETTER_AUTH_URL=http://localhost:3000
# Secret: generate with node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Leave empty for local development only; production requires at least 32 characters.
BETTER_AUTH_SECRET=
# Optional local persistent PostgreSQL-compatible PGlite directory. Never share one directory across processes.
PGLITE_DATA_DIR=./data/pglite
# Only for a single-process local production preview with a loopback BETTER_AUTH_URL.
# Public production must leave false and use DATABASE_URL.
ALLOW_LOCAL_DB=false
# Optional password recovery: configure both or leave both blank.
# SMTP username/password must be URL-encoded. No path or URL query options are accepted.
# Examples only: smtps://USER:PASSWORD@HOST:465 or smtp://USER:PASSWORD@HOST:587
# Remote SMTP requires TLS with certificate validation. Plain local SMTP is test/development only.
SMTP_URL=
# One verified sender; example only: Mizan Finance <no-reply@example.com>
MAIL_FROM=

# Optional tooling variables (defaults shown; leave commented unless needed).
# PORT=3000
# NEXT_TELEMETRY_DISABLED=1
# CAPTURE_URL=http://localhost:3000
# PERSISTENCE_TEST_ROOT=./data
# PLAYWRIGHT_PORT=3100
# PLAYWRIGHT_USE_PRODUCTION=false
# FINANCE_TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@localhost:5432/DISPOSABLE_TEST_DATABASE
# CI is set by the CI provider; NODE_ENV is set by Next.js. Do not put secrets in NEXT_PUBLIC_* variables.
# For a provider's private certificate authority, NODE_EXTRA_CA_CERTS may point to its trusted PEM file.
