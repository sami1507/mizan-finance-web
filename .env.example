# Copy to .env.local for Next.js. CLI scripts read .env; alternatively export variables in your shell.
# Production: use PostgreSQL 16+ and a unique secret generated with: openssl rand -hex 32
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Optional local persistent PostgreSQL-compatible PGlite directory. Never share one directory across processes.
PGLITE_DATA_DIR=./data/pglite
# Only for a single-process local production preview; production deployment needs DATABASE_URL.
ALLOW_LOCAL_DB=false
# Password recovery requires both SMTP values. It is explicitly unavailable until configured.
SMTP_URL=
MAIL_FROM=
